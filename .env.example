# Kopieer dit bestand naar .env en vul je gegevens in. Zie de README.
# .env staat in .gitignore en wordt dus nooit meegecommit.
PORT=8787
CARD_ID=              # de cijfers onder je QR-code
NS_API_BASE=          # basis-URL van de loyalty-API, bijv. https://<host>/<pad>
NS_SUBSCRIPTION_KEY=  # subscription-key uit de app
NS_PROVIDER=          # provider-waarde uit de app
NS_PASSWORD=""        # zet aanhalingstekens eromheen als de waarde een '#' bevat
NS_IMG_HOST=          # host van de productafbeeldingen (allowlist voor /img)
